  <version>0.1.0</version>
  <description>Message-agnostic YAML-configured ROS 2 to InfluxDB 2 bridge.</description>
  <maintainer email="maintainers@example.invalid">ROS 2 Influx Bridge contributors</maintainer>
  <license>Apache-2.0</license>
